  /* 划词连片允许相连的计量字：数字/字母 + 中文数字 + 楼栋房间与周次时间单位 */
  var TT_UNIT_RE = /[0-9A-Za-z一二三四五六七八九十百千零两第楼栋号室层周月日年点时分秒节上下午晚]/;
