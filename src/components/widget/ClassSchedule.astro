---
---
<div class="tt-root">
  <style is:global>
    .tt-root{--tt-panel:#fff;--tt-panel2:#f6f8f9;--tt-line:rgba(0,0,0,.09);--tt-tx:#23282e;--tt-tx2:#6a7480;--tt-on-bg:#e4f5f3;--tt-on-bd:#7cc9c0;--tt-on-tx:#12655e;--tt-off-bg:#f2f4f6;--tt-off-tx:#a3abb4;--tt-add-bg:#e8f4e2;--tt-add-bd:#8fc46b;--tt-add-tx:#3f6b1f;--tt-cx-bg:#fdecec;--tt-cx-tx:#a33;--tt-f-room-bg:#fff2d9;--tt-f-room:#b26a00;--tt-f-cx-bg:#fdecec;--tt-f-cx:#b03030;--tt-f-add-bg:#e8f4e2;--tt-f-add:#3f6b1f;--tt-f-mv-bg:#efe9fd;--tt-f-mv:#6a4fc0;--tt-today-bd:#5b8def;--tt-study-bg:#e9eefc;--tt-study-bd:#9bb6e8;--tt-study-tx:#2f4f8f;--tt-hover-sh:rgba(0,0,0,.1);--tt-log-c1:#ff6b6b;--tt-log-c2:#ffa94d;--tt-log-c3:#ffd43b;--tt-log-c4:#69db7c;--tt-log-c5:#4dabf7;--tt-log-c6:#9775fa;--tt-log-c7:#f783ac;--tt-log-c8:#22b8cf}
    html.dark .tt-root{--tt-panel:#181c1f;--tt-panel2:#20262a;--tt-line:rgba(255,255,255,.1);--tt-tx:#e6edf3;--tt-tx2:#9aa6b2;--tt-on-bg:#123c3a;--tt-on-bd:#3f9c93;--tt-on-tx:#a7e5dc;--tt-off-bg:#1d2226;--tt-off-tx:#5f6a75;--tt-add-bg:#1f3319;--tt-add-bd:#4f8a3a;--tt-add-tx:#a8d68a;--tt-cx-bg:#3a1a1a;--tt-cx-tx:#f29a9a;--tt-f-room-bg:#4a3410;--tt-f-room:#f5c46b;--tt-f-cx-bg:#4a1a1a;--tt-f-cx:#f29a9a;--tt-f-add-bg:#23391a;--tt-f-add:#a8d68a;--tt-f-mv-bg:#2e2748;--tt-f-mv:#c0b0f0;--tt-today-bd:#5b8def;--tt-study-bg:#1d2740;--tt-study-bd:#3f5fa8;--tt-study-tx:#aebfe6;--tt-hover-sh:rgba(0,0,0,.5);--tt-log-c1:#ff8787;--tt-log-c2:#ffc078;--tt-log-c3:#ffe066;--tt-log-c4:#8ce99a;--tt-log-c5:#74c0fc;--tt-log-c6:#b197fc;--tt-log-c7:#faa2c1;--tt-log-c8:#66d9e8}
    .tt-root{margin:18px 0;font-size:13px;line-height:1.6;color:var(--tt-tx)}
    .tt-panel{background:var(--tt-panel);border:1px solid var(--tt-line);border-radius:14px;padding:16px}
    .tt-top{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px}
    .tt-title{font-size:15px;font-weight:500}
    .tt-sub{font-size:12px;color:var(--tt-tx2)}
    .tt-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0 10px}
    .tt-bar button,.tt-bar select{flex:0 0 auto;font:inherit;font-size:12px;padding:4px 10px;border:1px solid var(--tt-line);background:var(--tt-panel2);color:var(--tt-tx);border-radius:8px;cursor:pointer}
    .tt-bar button:hover{border-color:var(--tt-on-bd)}
    /* 周次标签及其内部三段全部定宽（2026-10-10）：切换周次时按钮的横向位置与换行点保持不变。
       否则周号进位（第 9→10 周）、日期跨月（9/28 → 10/26）、「本周」徽章的出现/消失
       都会改变标签宽度 → 按钮被挤来挤去，连续点击时点不中。 */
    #tt-week{display:flex;flex:0 0 auto;align-items:center;gap:8px;font-size:14px}
    #tt-week b{flex:0 0 auto;min-width:58px;white-space:nowrap;font-variant-numeric:tabular-nums}
    .tt-wdate{flex:0 0 auto;min-width:82px;font-size:12px;color:var(--tt-tx2);font-variant-numeric:tabular-nums;white-space:nowrap}
    .tt-now{flex:0 0 auto;font-style:normal;font-size:11px;padding:1px 6px;border-radius:6px;background:var(--tt-on-bg);color:var(--tt-on-tx)}
    .tt-now.is-hidden{visibility:hidden}
    .tt-changes{margin:14px 0 0;padding:10px 12px;border:1px dashed var(--tt-line);border-radius:10px;background:var(--tt-panel2)}
    .tt-changes.is-empty{display:none}
    .tt-h4{font-size:13px;font-weight:500;margin:0 0 6px}
    .tt-changes h4{font-size:13px;font-weight:500;margin:0 0 6px;display:flex;align-items:baseline;gap:8px}
    .tt-chg-n{font-size:11px;font-weight:400;color:var(--tt-tx2)}
    .tt-changes ul{margin:0;padding-left:18px}
    .tt-changes li{font-size:12px}
    .tt-changes li+li{margin-top:2px}
    .tt-grid{display:grid;grid-template-columns:52px repeat(var(--tt-cols,5),minmax(84px,1fr));gap:6px;overflow-x:auto;padding-bottom:2px}
    .tt-row{display:contents}
    .tt-sl{font-size:11px;color:var(--tt-tx2);display:flex;flex-direction:column;justify-content:center;line-height:1.35}
    .tt-sl em{font-style:normal;font-size:10px;opacity:.75}
    .tt-dh{font-size:12px;color:var(--tt-tx2);text-align:center;display:flex;flex-direction:column;line-height:1.35;padding-bottom:2px}
    .tt-dh em{font-style:normal;font-size:10px;opacity:.75}
    .tt-dh.is-today{color:var(--tt-today-bd);font-weight:500}
    .tt-cell{position:relative;min-height:54px;border-radius:9px;padding:7px 8px;border:1px solid transparent;display:flex;flex-direction:column;justify-content:center}
    .tt-cell b{font-weight:500;font-size:13px}
    .tt-cell span{font-size:11px;margin-top:2px;opacity:.85;word-break:break-all}
    .tt-time{margin-top:3px;opacity:.7;font-variant-numeric:tabular-nums;letter-spacing:.2px}
    /* 课程卡片一律不描边（2026-10-10 用户要求「卡片不需要彩色的深色边框」）：
       只留底色 + 文字色，边框由 .tt-cell 的 1px transparent 占位保证尺寸不变。
       别把 border-color 加回来——is-on/is-add/is-study 三色描边已按用户要求删除。
       今日列的 .tt-cell.is-today 蓝色内描边是「今天」标识，用户未要求去掉，保留。 */
    .tt-root .is-on{background:var(--tt-on-bg);color:var(--tt-on-tx)}
    .tt-root .is-off{background:var(--tt-off-bg);color:var(--tt-off-tx)}
    .tt-root .is-add{background:var(--tt-add-bg);color:var(--tt-add-tx)}
    .tt-root .is-study{background:var(--tt-study-bg);color:var(--tt-study-tx)}
    .tt-root .is-cancel{background:var(--tt-cx-bg);color:var(--tt-cx-tx)}
    .tt-root .is-cancel b{text-decoration:line-through}
    .tt-root .is-empty{background:transparent}
    .tt-cell.is-today{box-shadow:inset 0 0 0 2px var(--tt-today-bd)}
    .tt-flag{position:absolute;top:4px;right:4px;font-size:9px;text-decoration:none;border-radius:4px;padding:0 4px;line-height:14px}
    .tt-root .f-room{background:var(--tt-f-room-bg);color:var(--tt-f-room)}
    .tt-root .f-move,.tt-root .f-swap{background:var(--tt-f-mv-bg);color:var(--tt-f-mv)}
    .tt-root .f-cancel{background:var(--tt-f-cx-bg);color:var(--tt-f-cx)}
    .tt-root .f-add{background:var(--tt-f-add-bg);color:var(--tt-f-add)}
    .tt-root .f-off{background:transparent;border:1px solid currentColor;opacity:.7}
    .tt-list{display:none;list-style:none;margin:14px 0 0;padding:0}
    .tt-list li{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid var(--tt-line);font-size:12px}
    .tt-list b{font-weight:500}
    .tt-list span{color:var(--tt-tx2)}
    .tt-legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;font-size:11px;color:var(--tt-tx2)}
    .tt-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
    .tt-foot{margin-top:10px;font-size:11px;color:var(--tt-tx2)}
    .tt-sec{margin-top:18px}
    .tt-periods{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:6px;list-style:none;margin:8px 0 0;padding:0}
    .tt-periods li{background:var(--tt-panel2);border-radius:8px;padding:6px 9px;font-size:12px;display:flex;justify-content:space-between;gap:6px}
    .tt-periods span{color:var(--tt-tx2);font-size:11px}
    .tt-periods li.tt-per-empty{background:transparent;border:1px dashed var(--tt-line);opacity:.7}
    .tt-err{font-size:12px;color:var(--tt-cx-tx)}
    .tt-cell[data-id]{cursor:pointer}
    .tt-cell.is-sel{outline:2px solid var(--tt-today-bd);outline-offset:-2px}
    .tt-cell[data-id]:focus-visible{outline:2px solid var(--tt-today-bd);outline-offset:-2px}
    .tt-detail{margin-top:12px;border:1px solid var(--tt-line);border-radius:10px;background:var(--tt-panel2);overflow:hidden}
    .tt-detail.is-empty{display:none}
    .tt-dtop{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 12px;border-bottom:1px solid var(--tt-line)}
    .tt-dname{font-size:13px;font-weight:500}
    .tt-dclose{border:none;background:transparent;color:var(--tt-tx2);font-size:16px;line-height:1;cursor:pointer;padding:2px 6px;border-radius:6px}
    .tt-dclose:hover{background:var(--tt-line)}
    .tt-dbody{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;padding:10px 12px}
    .tt-dbody>div{display:flex;flex-direction:column;gap:2px}
    .tt-dbody b{font-size:11px;font-weight:400;color:var(--tt-tx2)}
    .tt-dbody span{font-size:12px}
    .tt-old{font-style:normal;font-size:11px;opacity:.7;margin-left:4px}
    .tt-dnote{padding:0 12px 10px;font-size:12px;color:var(--tt-tx2);line-height:1.6}
    .tt-notices-panel{margin-bottom:14px}
    .tt-notices-panel .tt-top{margin-bottom:10px}
    .tt-notices{display:flex;flex-direction:column;gap:10px}
    .tt-nt{border-left:3px solid var(--tt-on-bd);background:var(--tt-panel2);border-radius:8px;padding:8px 12px}
    .tt-nt-head{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:2px}
    .tt-nt-date{font-size:11px;color:var(--tt-tx2)}
    .tt-nt-title{font-size:13px;font-weight:500}
    .tt-nt-text{font-size:12px;color:var(--tt-tx);line-height:1.6;white-space:pre-wrap}
    .tt-nt-none{color:var(--tt-tx2);opacity:.8;font-size:12px}
    /* ===== 数据更新历面板（多彩鲜艳风格）===== */
    .tt-log-panel{margin-top:14px}
    .tt-log-panel .tt-top{margin-bottom:10px;align-items:center}
    .tt-log-panel .tt-title{font-weight:600;background:linear-gradient(90deg,#ff6b6b,#ffa94d,#4dabf7,#9775fa,#f783ac);-webkit-background-clip:text;background-clip:text;color:transparent}
    .tt-log-panel .tt-sub{color:var(--tt-log-c5);font-weight:500}
    .tt-log{list-style:none;margin:0;padding:0;max-height:360px;overflow-y:auto;padding-right:4px}
    .tt-log li{position:relative;display:flex;gap:10px;padding:8px 0 8px 14px;border-top:1px solid var(--tt-line);font-size:12px}
    .tt-log li:first-child{border-top:none}
    .tt-log li:nth-child(8n+1){--lc:var(--tt-log-c1)}
    .tt-log li:nth-child(8n+2){--lc:var(--tt-log-c2)}
    .tt-log li:nth-child(8n+3){--lc:var(--tt-log-c3)}
    .tt-log li:nth-child(8n+4){--lc:var(--tt-log-c4)}
    .tt-log li:nth-child(8n+5){--lc:var(--tt-log-c5)}
    .tt-log li:nth-child(8n+6){--lc:var(--tt-log-c6)}
    .tt-log li:nth-child(8n+7){--lc:var(--tt-log-c7)}
    .tt-log li:nth-child(8n+8){--lc:var(--tt-log-c8)}
    .tt-log li::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:4px;border-radius:3px;background:var(--lc)}
    .tt-log-date{flex:0 0 auto;min-width:86px;color:var(--lc);background:color-mix(in srgb,var(--lc) 16%,var(--tt-panel));border-radius:6px;padding:1px 6px;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center;align-self:center}
    .tt-log-text{flex:1;color:var(--tt-tx);line-height:1.6}
    /* 更新历正文重点词高亮：6 类，颜色×形式组合，信息有区分；配色用浅色/柔和。
       划线叠加：高亮词自带同色划线（波浪/直线/虚线），更像手写划重点。 */
    .tt-root .tt-kw{font-weight:600;border-radius:4px;padding:0 3px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
    /* role 角色——紫·浅底+浅字+波浪线 */
    .tt-root .tt-kw-role{color:#9775fa;background:rgba(151,117,250,.16);text-decoration:#9775fa wavy underline;text-decoration-thickness:1.5px;text-underline-offset:3px}
    /* bld 楼宇——绿·浅底+浅字+实线 */
    .tt-root .tt-kw-bld{color:#51cf66;background:rgba(105,219,124,.16);text-decoration:#51cf66 solid underline;text-decoration-thickness:1.5px;text-underline-offset:3px}
    /* subj 科目——橙·描边（无底色，浅字）+实线 */
    .tt-root .tt-kw-subj{color:#ff922b;border:1.5px solid #ffa94d;background:transparent;text-decoration:#ff922b solid underline;text-decoration-thickness:1.5px;text-underline-offset:3px}
    /* evt 事项——蓝·浅底+浅字+实线 */
    .tt-root .tt-kw-evt{color:#4dabf7;background:rgba(77,171,247,.16);text-decoration:#4dabf7 solid underline;text-decoration-thickness:1.5px;text-underline-offset:3px}
    /* act 中性动作——粉·下划线（无底色，浅字） */
    .tt-root .tt-kw-act{color:#f06595;border-bottom:2px solid #f783ac;border-radius:0;padding:0 1px;background:transparent}
    /* neg 负面动作——红·虚线下划线（浅字） */
    .tt-root .tt-kw-neg{color:#ff8787;border-bottom:2px dashed #ff6b6b;border-radius:0;padding:0 1px;background:transparent}
    /* 划句：按「语义重点度」分档。含重点词的整句先铺一层淡荧光黄标出影响范围，
       再按句子内容判档——必看句（时间/地点/要求动作）加浓一档 + 加粗 + 句首竖条。 */
    .tt-root .tt-sent{background:rgba(255,212,59,.16);border-radius:3px;padding:0 2px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
    .tt-root .tt-sent-core{background:rgba(255,212,59,.30);font-weight:600}
    /* 必看句的句首竖条，纯装饰 */
    .tt-root .tt-mark{display:inline-block;width:3px;height:11px;border-radius:2px;background:#ffa000;margin-right:4px;vertical-align:-1px}
    /* 更新历顶部的重点度图例 */
    .tt-log-hint{display:flex;flex-wrap:wrap;gap:12px;margin:8px 0 2px;font-size:10.5px;color:var(--tt-tx2)}
    .tt-log-hint span{display:inline-flex;align-items:center}
    .tt-log-hint em{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:4px;background:rgba(255,212,59,.30);border:1px solid rgba(255,212,59,.55)}
    .tt-log-hint em.k{background:rgba(255,212,59,.16);border-color:rgba(255,212,59,.32)}
    /* 暗主题：文字转浅色、底色/描边用同色系浅调，保持柔和且可读 */
    html.dark .tt-root .tt-kw-role{color:#b197fc;background:rgba(151,117,250,.20);text-decoration-color:#b197fc}
    html.dark .tt-root .tt-kw-bld{color:#8ce99a;background:rgba(105,219,124,.18);text-decoration-color:#8ce99a}
    html.dark .tt-root .tt-kw-subj{color:#ffa94d;border-color:#ffa94d;text-decoration-color:#ffa94d}
    html.dark .tt-root .tt-kw-evt{color:#74c0fc;background:rgba(77,171,247,.20);text-decoration-color:#74c0fc}
    html.dark .tt-root .tt-kw-act{color:#faa2c1;border-bottom-color:#f783ac}
    html.dark .tt-root .tt-kw-neg{color:#ff8787;border-bottom-color:#ff6b6b}
    html.dark .tt-root .tt-sent{background:rgba(255,212,59,.11)}
    html.dark .tt-root .tt-sent-core{background:rgba(255,212,59,.20)}
    html.dark .tt-root .tt-mark{background:#ffd43b}
    .tt-log li:first-child{background:linear-gradient(90deg,color-mix(in srgb,var(--tt-log-c5) 14%,transparent),transparent);border-radius:8px}
    .tt-log li:first-child::after{content:"最新";flex:0 0 auto;align-self:center;font-size:10px;color:#fff;background:var(--tt-log-c5);border-radius:5px;padding:0 5px;line-height:16px;margin-left:2px}
    @media(max-width:640px){
      .tt-list{display:block}
      .tt-panel{padding:12px}
      /* 更新历手机端改为竖排：日期独占一行在上方，正文占满整行，消除日期列占 1/3 且上下留白。
         注意：此块必须放在 .tt-log 基础规则之后，否则 align-self:center 会反向覆盖导致徽章水平居中 */
      .tt-log li{flex-direction:column;align-items:stretch;gap:5px;padding:9px 0 9px 14px}
      .tt-log-date{align-self:flex-start;min-width:0}
      .tt-log li:first-child::after{position:absolute;top:9px;right:6px;margin-left:0}
    }

    /* ===== 交互反馈：按钮 / 周次切换 / 详情面板（2026-10-10）===== */
    /* —— 按钮：悬停描边 + 方向箭头位移 + 按下回弹 + 点击涟漪 + 键盘焦点环 + 边界置灰 —— */
    .tt-bar button,.tt-bar select{transition:border-color .18s ease,background-color .18s ease,color .18s ease,box-shadow .18s ease,transform .12s cubic-bezier(.22,.61,.36,1)}
    .tt-bar button{position:relative;overflow:hidden}
    .tt-bar button>*{position:relative;z-index:1}
    .tt-bar button:hover,.tt-bar select:hover{border-color:var(--tt-on-bd)}
    .tt-bar button:hover{box-shadow:0 1px 6px var(--tt-hover-sh)}
    .tt-bar button:active:not(:disabled){transform:translateY(1px) scale(.96)}
    .tt-bar button:focus-visible,.tt-bar select:focus-visible{outline:2px solid var(--tt-today-bd);outline-offset:1px}
    .tt-bar button:disabled{opacity:.42;cursor:not-allowed}
    .tt-bar button:disabled:hover{border-color:var(--tt-line);box-shadow:none}
    .tt-ar{display:inline-block;transition:transform .2s cubic-bezier(.22,.61,.36,1)}
    #tt-prev:hover:not(:disabled) .tt-ar{transform:translateX(-3px)}
    #tt-next:hover:not(:disabled) .tt-ar{transform:translateX(3px)}
    .tt-ripple{position:absolute;border-radius:50%;pointer-events:none;background:currentColor;opacity:.2;transform:scale(0);z-index:0;animation:tt-ripple .52s cubic-bezier(.22,.61,.36,1) forwards}
    @keyframes tt-ripple{to{transform:scale(2.6);opacity:0}}

    /* —— 单元格：悬停抬起、按下回弹（今日格保留内描边）、选中脉冲环 —— */
    .tt-cell[data-id]{transition:transform .14s cubic-bezier(.22,.61,.36,1),box-shadow .18s ease}
    .tt-cell[data-id]:hover{box-shadow:0 1px 6px var(--tt-hover-sh)}
    .tt-cell[data-id]:active{transform:translateY(1px) scale(.985)}
    .tt-cell.is-today[data-id]:hover{box-shadow:inset 0 0 0 2px var(--tt-today-bd),0 1px 6px var(--tt-hover-sh)}
    .tt-cell.is-sel{animation:tt-ring .52s ease-out backwards}
    @keyframes tt-ring{0%{box-shadow:0 0 0 0 rgba(91,141,239,.55)}100%{box-shadow:0 0 0 9px rgba(91,141,239,0)}}

    /* —— 详情关闭按钮 —— */
    .tt-dclose{transition:background-color .15s ease,color .15s ease,transform .12s ease}
    .tt-dclose:active{transform:scale(.88)}

    /* —— 周次切换（四组动画各管一段）——
       2026-10-10 用户反馈"切换动画卡卡的"，要求改成滑动切换：
       ① 网格从「几十个格子各带 transform/opacity 动画」改成 **整块滑动**——
          旧的一层克隆出来滑出、新的一层滑入，只有 2 个合成层（GPU 友好，不再掉帧）；
          ⚠️ 别再退回逐格级联（`--tt-d*16ms` 那套），格子多时必掉帧。
          实现见 JS 的 snapshotGrid() / playSlide()。 */
    .tt-grid-wrap{position:relative;overflow:hidden;transition:height .26s ease}
    .tt-grid-old{position:absolute;left:0;right:0;top:0;pointer-events:none}
    #tt-grid.tt-slide-in-next,#tt-grid.tt-slide-in-prev{will-change:transform}
