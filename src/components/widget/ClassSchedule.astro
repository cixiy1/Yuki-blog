    "图书馆": "bld", "实验楼": "bld", "报告厅": "bld", "体育馆": "bld", "田径场": "bld", "看台": "bld", "操场": "bld", "食堂": "bld", "北校区": "bld",
    "习概": "subj", "Web": "subj", "Java": "subj", "C语言": "subj", "军事理论": "subj", "体育": "subj",
