---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { encryptContent } from "@utils/crypto-utils";
import { Icon } from "astro-icon/components";

interface Props {
	password: string;
	slug: string;
	hint?: string;
}

const { password, slug, hint = "" } = Astro.props;

const rawHtml = await Astro.slots.render("default");
const encryptedData = encryptContent(rawHtml, password, slug);

const labels = {
	protected: i18n(I18nKey.passwordProtected),
	desc: i18n(I18nKey.passwordProtectedDesc),
	hint: i18n(I18nKey.passwordHint),
	placeholder: i18n(I18nKey.passwordPlaceholder),
	submit: i18n(I18nKey.passwordSubmit),
	error: i18n(I18nKey.passwordError),
};
---

<div
  id="encrypted-container"
  data-encrypted={encryptedData}
  data-slug={slug}
>
  <!-- Lock UI -->
  <div id="password-ui" class="flex justify-center py-16 px-4">
    <div class="card-base flex flex-col items-center gap-3 max-w-100 w-full p-8">
      <Icon name="material-symbols:shield-lock" class="text-8xl text-(--primary)" />

      <h2 class="text-lg font-bold text-black/80 dark:text-white/80 m-0">{labels.protected}</h2>
      <p class="text-sm text-black/40 dark:text-white/40 text-center m-0">{labels.desc}</p>

      {hint && (
        <p class="text-xs text-black/30 dark:text-white/30 text-center m-0">{labels.hint}: {hint}</p>
      )}

      <form id="password-form" class="w-full mt-2 space-y-2">
        <input
          id="password-input"
          name="password"
          type="password"
          placeholder={labels.placeholder}
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
                 border border-black/8 dark:border-white/8
                 text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
                 outline-hidden focus:border-(--primary) transition"
        />
        <button
          type="submit"
          class="w-full py-2 rounded-lg text-sm font-medium bg-(--primary) text-white dark:text-black/70
                 hover:opacity-85 active:scale-[0.98] transition-all"
        >
          {labels.submit}
        </button>
      </form>

      <p id="password-error" class="text-xs text-red-500 dark:text-red-400 m-0 hidden">{labels.error}</p>
      <p id="password-debug" class="text-[10px] text-black/25 dark:text-white/25 m-0 hidden break-all text-center"></p>
    </div>
  </div>

  <!-- Decrypted content injected here -->
  <div id="decrypted-content" class="hidden"></div>
</div>

<script is:inline>
(function() {
  var ITERATIONS = 100000;
  var SALT_LEN = 16;
  var IV_LEN = 12;
  var TAG_LEN = 16;

  function base64ToBytes(b64) {
    var bin = atob(b64);
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) {
      bytes[i] = bin.charCodeAt(i);
    }
    return bytes;
  }

  // 诊断辅助：把关键环境信息压缩成一行，解密失败时显示，便于定位
  // 是「密码被输入法改形」还是「浏览器不支持 WebCrypto」
  function envInfo() {
    var hasSubtle = !!(window.crypto && window.crypto.subtle);
    var secure = window.isSecureContext ? 1 : 0;
    return 'subtle:' + (hasSubtle ? 1 : 0) + ' secure:' + secure;
  }

  function pwdDiag(raw) {
    var first = raw && raw.length ? raw.charCodeAt(0).toString(16) : 'none';
    return 'len:' + (raw ? raw.length : 0) + ' cp0:0x' + first;
  }

  function init() {
    var container = document.getElementById('encrypted-container');
    if (!container) return;
    // 幂等：整页加载与 Swup 切页可能各触发一次
    if (container.getAttribute('data-pw-init') === '1') return;
    container.setAttribute('data-pw-init', '1');

    var encryptedData = container.getAttribute('data-encrypted');
    var slug = container.getAttribute('data-slug');
    var cacheKey = 'pw:' + slug;

    var ui = document.getElementById('password-ui');
    var form = document.getElementById('password-form');
    var input = document.getElementById('password-input');
    var errorEl = document.getElementById('password-error');
    var debugEl = document.getElementById('password-debug');
    var contentEl = document.getElementById('decrypted-content');
    if (!ui || !form || !input || !contentEl) return;

    function showContent(html) {
      contentEl.innerHTML = html;
      contentEl.classList.remove('hidden');
      ui.classList.add('hidden');
      // Scripts injected via innerHTML are inert — re-create them so they execute
      var scripts = contentEl.querySelectorAll('script');
      for (var i = 0; i < scripts.length; i++) {
        var old = scripts[i];
        var ns = document.createElement('script');
        for (var j = 0; j < old.attributes.length; j++) {
          ns.setAttribute(old.attributes[j].name, old.attributes[j].value);
        }
        ns.textContent = old.textContent;
        old.parentNode.replaceChild(ns, old);
      }
      // Re-init components after content is in DOM
      setTimeout(function() {
        document.dispatchEvent(new CustomEvent('password:decrypted'));
      }, 100);

      // 初始化解密内容中图片的 LQIP 淡入
      var placeholders = contentEl.querySelectorAll('.lqip-placeholder');
      for (var k = 0; k < placeholders.length; k++) {
        (function(placeholder) {
          var box = placeholder.parentElement;
          if (!box) return;
          var img = box.querySelector('img');
          if (!img) return;
          if (img.complete && img.naturalWidth > 0) {
            img.style.opacity = '1';
            placeholder.classList.add('loaded');
          } else {
            img.addEventListener('load', function() {
              img.style.opacity = '1';
              placeholder.classList.add('loaded');
            }, { once: true });
            img.addEventListener('error', function() {
              placeholder.classList.add('loaded');
            }, { once: true });
          }
        })(placeholders[k]);
      }
    }

    function showError(code, info) {
      if (errorEl) errorEl.classList.remove('hidden');
      if (debugEl) {
        debugEl.textContent = code + (info ? ' · ' + info : '');
        debugEl.classList.remove('hidden');
      }
      try {
        console.warn('[encrypted]', code, info || '', envInfo(), navigator.userAgent);
      } catch (e) {}
    }

    function hideError() {
      if (errorEl) errorEl.classList.add('hidden');
      if (debugEl) debugEl.classList.add('hidden');
    }

    // 能力检测：老内核（微信 X5 / 老 Android WebView）没有 WebCrypto，
    // 这类设备上无论输什么密码都只会报错，所以降级到纯 JS 实现：
    // public/assets/js/pw-fallback.js（noble-hashes + noble-ciphers，
    // 算法与 WebCrypto 完全一致，构建时由 esbuild 打包）。
    var useWebCrypto = !!(window.crypto && window.crypto.subtle);
    var fallbackPromise = null;

    function ensureFallback() {
      if (window.__pwFallback) return Promise.resolve(window.__pwFallback);
      if (fallbackPromise) return fallbackPromise;
      fallbackPromise = new Promise(function(resolve, reject) {
        var s = document.createElement('script');
        s.src = '/assets/js/pw-fallback.js';
        s.async = true;
        s.onload = function() {
          if (window.__pwFallback) resolve(window.__pwFallback);
          else reject({ code: 'fallback-no-api' });
        };
        s.onerror = function() {
          reject({ code: 'fallback-load-failed' });
        };
        document.head.appendChild(s);
      });
      return fallbackPromise;
    }

    function decryptViaFallback(pwd) {
      return ensureFallback().then(function(fb) {
        try {
          return fb.decryptWithPassword(pwd, encryptedData);
        } catch (e) {
          throw { code: 'mismatch' };
        }
      });
    }

    async function decryptViaSubtle(pwd) {
      var raw = base64ToBytes(encryptedData);
      var salt = raw.slice(0, SALT_LEN);
      var iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
      var authTag = raw.slice(SALT_LEN + IV_LEN, SALT_LEN + IV_LEN + TAG_LEN);
      var ciphertext = raw.slice(SALT_LEN + IV_LEN + TAG_LEN);

      var combined = new Uint8Array(ciphertext.length + TAG_LEN);
      combined.set(ciphertext);
      combined.set(authTag, ciphertext.length);

      var enc = new TextEncoder();
      var keyMaterial = await crypto.subtle.importKey(
        'raw', enc.encode(pwd), 'PBKDF2', false, ['deriveBits', 'deriveKey']
      );
      var key = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: salt, iterations: ITERATIONS, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
      var decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: iv }, key, combined);
      return new TextDecoder().decode(decrypted);
    }

    // 统一入口：优先 WebCrypto，环境不支持时自动切纯 JS
    function decryptAny(pwd) {
      if (!useWebCrypto) return decryptViaFallback(pwd);
      return decryptViaSubtle(pwd).catch(function(err) {
        // OperationError = 认证失败，就是密码不对，换算法也没用
        if (err && (err.name === 'OperationError' || err.name === 'InvalidAccessError')) {
          throw { code: 'mismatch' };
        }
        // TypeError / 其他 = 该环境实际用不了 WebCrypto（旧 X5、非安全上下文）
        useWebCrypto = false;
        return decryptViaFallback(pwd);
      });
    }

    // 手机输入法常把数字打成全角（２６１５），或从聊天/文档复制时带入零宽字符、
    // 空格。这些字符肉眼不可见，但会让 PBKDF2 派生出另一把密钥，
    // 表现为「密码明明是对的却提示错误」。逐个变体尝试，任一通过即可。
    function pwdVariants(pwd) {
      var list = [];
      function add(v) {
        if (v && list.indexOf(v) < 0) list.push(v);
      }
      add(pwd);
      // 去掉所有空白与零宽字符（\s 已含全角空格 U+3000）
      var stripped = pwd.replace(/[\s\u200B-\u200D\uFEFF]+/g, '');
      add(stripped);
      var bases = [pwd, stripped];
      for (var i = 0; i < bases.length; i++) {
        if (!bases[i]) continue;
        try {
          add(bases[i].normalize('NFKC'));
        } catch (e) {
          // 老内核不支持 normalize，忽略
        }
      }
      return list;
    }

    // 依次尝试各变体，任一解密成功即返回 { html, pwd }
    function attempt(pwd) {
      var variants = pwdVariants(pwd);
      return new Promise(function(resolve, reject) {
        var lastCode = 'mismatch';
        (function next(i) {
          if (i >= variants.length) {
            reject({ code: lastCode });
            return;
          }
          decryptAny(variants[i])
            .then(function(html) {
              resolve({ html: html, pwd: variants[i] });
            })
            .catch(function(err) {
              // 环境类错误（如兜底脚本加载失败）要透传，别被「密码错误」盖住
              if (err && err.code && err.code !== 'mismatch') lastCode = err.code;
              next(i + 1);
            });
        })(0);
      });
    }

    function fail(err, raw) {
      var code = (err && err.code) || 'decrypt-error';
      showError(code, pwdDiag(raw) + ' ' + envInfo() + ' ' + (useWebCrypto ? 'engine:webcrypto' : 'engine:fallback'));
    }

    // sessionStorage 在无痕模式 / 部分 WebView 里会直接抛错，
    // 不能让它把「解密成功」变成「报错」
    function readCache() {
      try {
        return sessionStorage.getItem(cacheKey);
      } catch (e) {
        return null;
      }
    }

    function writeCache(v) {
      try {
        sessionStorage.setItem(cacheKey, v);
      } catch (e) {}
    }

    function dropCache() {
      try {
        sessionStorage.removeItem(cacheKey);
      } catch (e) {}
    }

    // 纯 JS 解密在低端手机上要跑 10 万次 PBKDF2（1-2 秒），
    // 期间给按钮一个忙碌态，避免被当成没反应
    var submitBtn = form.querySelector ? form.querySelector('button[type="submit"]') : null;

    function setBusy(busy) {
      if (!submitBtn) return;
      submitBtn.disabled = busy;
      submitBtn.style.opacity = busy ? '0.6' : '';
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var raw = input.value;
      var pwd = raw.trim();
      if (!pwd) return;
      hideError();
      setBusy(true);

      attempt(pwd)
        .then(function(res) {
          // 缓存实际生效的规范形式，下次自动解锁不会再踩同样的坑
          writeCache(res.pwd);
          showContent(res.html);
          setBusy(false);
        })
        .catch(function(err) {
          setBusy(false);
          fail(err, raw);
        });
    });

    var cached = readCache();
    if (cached) {
      attempt(cached)
        .then(function(res) {
          writeCache(res.pwd);
          showContent(res.html);
        })
        .catch(function() {
          dropCache();
        });
    }
  }

  // 整页加载 & Swup 站内切页都要初始化：
  // 只跑一次 IIFE 的话，从站内导航进文章时表单没有 submit 监听，
  // 会退化成浏览器原生提交（页面刷新），看起来就像解锁失败。
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('swup:contentReplaced', init);
  document.addEventListener('swup:page:view', init);
})();
</script>
