---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { statsConfig } from "@/config";
import { getStatsPostList } from "@/utils/stats-utils";

const pageCfg = statsConfig.page;
const enabled = statsConfig.enable && pageCfg.enable;

// 文章清单在构建期生成，直接渲染成 DOM（数字由 stats-page.js 从计数服务读取后填入）。
// ⚠️ 不要把这份清单塞进内联 <script>：Swup 站内跳转时容器是整块替换的，
//    内联脚本在 SPA 导航下不保证执行，而 DOM 一定是新的。
const posts = enabled ? await getStatsPostList() : [];
---

<MainGridLayout title={pageCfg.title} description={pageCfg.description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div
      id="stats-root"
      class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full"
      data-trend-days={pageCfg.trendDays}
      data-top-n={pageCfg.topN}
    >
      {
        !enabled ? (
          <p class="sp-empty">站内统计未启用。</p>
        ) : (
          <>
            <div class="sp-head">
              <div>
                {/* 大屏由 banner 统一显示页面标题，这里只在窄屏补一个 */}
                <h1 class="sp-title lg:hidden">{pageCfg.title}</h1>
                <p class="sp-desc">{pageCfg.description}</p>
              </div>
              <button id="stats-refresh" class="sp-btn" type="button">
                刷新数据
              </button>
            </div>

            {/* 概览 */}
            <div class="sp-cards">
              <div class="sp-card">
                <div class="sp-card-label">总浏览量</div>
                <div class="sp-card-value" data-stat="pv">
                  —
                </div>
                <div class="sp-card-sub">建站至今</div>
              </div>
              <div class="sp-card">
                <div class="sp-card-label">总访客数</div>
                <div class="sp-card-value" data-stat="uv">
                  —
                </div>
                <div class="sp-card-sub">浏览器去重</div>
              </div>
              <div class="sp-card">
                <div class="sp-card-label">今日浏览</div>
                <div class="sp-card-value" data-stat="pvToday">
                  —
                </div>
                <div class="sp-card-sub">截至现在</div>
              </div>
              <div class="sp-card">
                <div class="sp-card-label">今日访客</div>
                <div class="sp-card-value" data-stat="uvToday">
                  —
                </div>
                <div class="sp-card-sub">截至现在</div>
              </div>
            </div>

            {/* 趋势 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">近 {pageCfg.trendDays} 天浏览量</h2>
                <div class="sp-section-extra">
                  日均 <b data-stat="avg">—</b> 次
                </div>
              </div>
              <div id="stats-trend" class="sp-trend">
                <p class="sp-empty">正在读取…</p>
              </div>
            </section>

            {/* 排行 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">文章阅读排行</h2>
                <div class="sp-section-extra">
                  累计 <b data-stat="total">—</b> 次
                </div>
              </div>
              <div id="stats-rank" class="sp-rank">
                {
                  posts.length === 0 ? (
                    <p class="sp-empty">没有可统计的文章。</p>
                  ) : (
                    posts.map((post, index) => (
                      <a
                        class="sp-rank-row"
                        href={post.url}
                        data-rank-id={post.id}
                        data-published={post.published}
                        data-rank={index + 1}
                      >
                        <span class="sp-rank-no">{index + 1}</span>
                        <span class="sp-rank-main">
                          <span class="sp-rank-title">{post.title}</span>
                          <span class="sp-rank-meta">
                            {post.published}
                            {post.category ? ` · ${post.category}` : ""}
                          </span>
                          <span class="sp-rank-track">
                            <i style="width:0%" />
                          </span>
                        </span>
                        <span class="sp-rank-num" data-rank-num>
                          …
                        </span>
                      </a>
                    ))
                  )
                }
              </div>
              <button
                id="stats-rank-toggle"
                class="sp-btn sp-btn-block"
                type="button"
                hidden
              >
                显示全部
              </button>
            </section>

            <p id="stats-status" class="sp-status" aria-live="polite">
              正在读取数据…
            </p>
            <p class="sp-note">
              统计由站内计数器在浏览器端完成，不使用 Cookie 追踪，只记录「页面被访问了几次」。
              加密文章不参与排行；同一页面 {statsConfig.dedupeMinutes} 分钟内的重复访问只计一次。
              更细致的来源、设备与行为分析见站长的 Microsoft Clarity 后台。
            </p>
          </>
        )
      }
    </div>
  </div>
</MainGridLayout>

<style is:global>
  /* 说明：颜色尽量复用主题变量，自动跟随浅色 / 深色与主题色相。
     排行行由 Astro 服务端渲染（好让无 JS 时也能看到文章清单），
     但柱状图是 stats-page.js 运行时插入的，所以这里统一用全局样式。 */
  .sp-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sp-title {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .sp-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--content-meta);
  }

  .sp-btn {
    flex: 0 0 auto;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    color: inherit;
    background: transparent;
    border: 1px solid var(--line-divider);
    border-radius: 0.6rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .sp-btn:hover {
    background: var(--license-block-bg);
  }

  .sp-btn:active {
    transform: scale(0.97);
  }

  .sp-btn-block {
    display: block;
    width: 100%;
    margin-top: 0.75rem;
  }

  /* ⚠️ 不要依赖「继承」拿文字颜色。
     主题只在它自己的组件里用 text-black/90 dark:text-white/90 这类工具类显式上色，
     body 上并没有一个会在深色模式翻白的默认字色。自定义样式如果不上色，
     深色模式下就会拿到 rgb(0,0,0) ——黑字压在深色卡片上直接看不见。
     下面这组选择器覆盖所有「非 .sp-* 已显式上色」的正文元素。 */
  .sp-title,
  .sp-card-value,
  .sp-section-title,
  .sp-rank-title,
  .sp-rank-num {
    color: rgb(0 0 0 / 0.9);
  }

  :root.dark .sp-title,
  :root.dark .sp-card-value,
  :root.dark .sp-section-title,
  :root.dark .sp-rank-title,
  :root.dark .sp-rank-num {
    color: rgb(255 255 255 / 0.9);
  }

  /* 概览卡片 */
  .sp-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
  }

  .sp-card {
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
    background: var(--license-block-bg);
  }

  .sp-card-label {
    font-size: 0.75rem;
    color: var(--content-meta);
  }

  .sp-card-value {
    margin: 0.15rem 0 0.1rem;
    font-size: 1.5rem;
    line-height: 1.9rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .sp-card-sub {
    font-size: 0.68rem;
    color: var(--content-meta);
  }

  /* 区块 */
  .sp-section {
    margin-top: 2rem;
  }

  .sp-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-divider);
  }

  .sp-section-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .sp-section-extra {
    font-size: 0.78rem;
    color: var(--content-meta);
    white-space: nowrap;
  }

  .sp-section-extra b {
    color: var(--primary);
  }

  /* 趋势图 */
  .sp-trend {
    overflow: visible;
  }

  .sp-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 11rem;
    margin-bottom: 1.6rem;
  }

  .sp-bar-wrap {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .sp-bar {
    width: 100%;
    min-height: 2px;
    border-radius: 4px 4px 2px 2px;
    background: var(--primary);
    opacity: 0.7;
    animation: sp-grow 0.5s ease both;
  }

  .sp-bar-wrap:hover .sp-bar {
    opacity: 1;
  }

  .sp-bar-wrap.is-today .sp-bar {
    background: var(--content-meta);
    opacity: 0.5;
  }

  .sp-bar-label {
    position: absolute;
    bottom: -1.35rem;
    font-size: 0.65rem;
    color: var(--content-meta);
    white-space: nowrap;
  }

  .sp-chart-foot {
    margin: 0;
    font-size: 0.75rem;
    color: var(--content-meta);
    text-align: center;
  }

  /* 排行榜 */
  .sp-rank-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.6rem;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .sp-rank-row:hover {
    background: var(--license-block-bg);
  }

  .sp-rank-no {
    flex: 0 0 auto;
    width: 1.6rem;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--content-meta);
  }

  .sp-rank-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .sp-rank-title {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sp-rank-meta {
    font-size: 0.7rem;
    color: var(--content-meta);
  }

  .sp-rank-track {
    display: block;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--license-block-bg);
    overflow: hidden;
  }

  .sp-rank-track i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--primary);
    transition: width 0.6s ease;
  }

  .sp-rank-num {
    flex: 0 0 auto;
    min-width: 3.5rem;
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* 状态与说明 */
  .sp-status {
    margin: 1.5rem 0 0;
    font-size: 0.75rem;
    color: var(--content-meta);
  }

  .sp-status[data-kind="error"] {
    color: #dc2626;
  }

  .sp-note {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--content-meta);
  }

  .sp-empty {
    margin: 0;
    padding: 1rem 0;
    font-size: 0.85rem;
    color: var(--content-meta);
  }

  @keyframes sp-grow {
    from {
      transform: scaleY(0.2);
      transform-origin: bottom;
    }
    to {
      transform: scaleY(1);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-bar,
    .sp-rank-track i {
      animation: none;
      transition: none;
    }
  }
</style>
