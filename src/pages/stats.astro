---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { statsConfig } from "@/config";
import { getStatsPostList } from "@/utils/stats-utils";

const pageCfg = statsConfig.page;
const enabled = statsConfig.enable && pageCfg.enable;

// 文章清单在构建期生成，直接渲染成 DOM（数字由 stats-page.js 从计数服务读取后填入）。
// ⚠️ 不要把这份清单塞进内联 <script>：Swup 站内跳转时容器是整块替换的，
//    内联脚本在 SPA 导航下不保证执行，而 DOM 一定是新的。
const posts = enabled ? await getStatsPostList() : [];
---

<MainGridLayout title={pageCfg.title} description={pageCfg.description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div
      id="stats-root"
      class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full text-black/90 dark:text-white/90"
      data-trend-days={pageCfg.trendDays}
      data-top-n={pageCfg.topN}
    >
      {
        !enabled ? (
          <p class="sp-empty text-black/70 dark:text-white/60">站内统计未启用。</p>
        ) : (
          <>
            <div class="sp-head">
              {/* 大屏由 banner 统一显示页面标题，这里只在窄屏补一个 */}
              <h1 class="sp-title lg:hidden">{pageCfg.title}</h1>
              <p class="sp-desc text-black/70 dark:text-white/60">{pageCfg.description}</p>
            </div>

            {/* 概览 */}
            <div class="sp-cards">
              <section class="sp-group">
                <h3 class="sp-group-title">总计</h3>
                <div class="sp-group-cards">
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">总浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pv">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">建站至今</div>
                  </div>
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">总访客数</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uv">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">浏览器去重</div>
                  </div>
                </div>
              </section>

              <section class="sp-group">
                <h3 class="sp-group-title">单日 · 今日</h3>
                <div class="sp-group-cards">
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pvToday">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">截至现在</div>
                  </div>
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uvToday">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">截至现在</div>
                  </div>
                </div>
              </section>

              <section class="sp-group">
                <h3 class="sp-group-title">单周 · 本周</h3>
                <div class="sp-group-cards">
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pvWeek">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">周一至今</div>
                  </div>
                  <div class="sp-card bg-(--primary)/10 hover:bg-(--primary)/20 transition-colors">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uvWeek">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">周一至今</div>
                  </div>
                </div>
              </section>
            </div>

            {/* 趋势 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">近 {pageCfg.trendDays} 天浏览量</h2>
                <div class="sp-section-extra text-black/70 dark:text-white/60">
                  日均 <b data-stat="avg">—</b> 次
                </div>
              </div>
              <div id="stats-trend" class="sp-trend">
                <p class="sp-empty text-black/70 dark:text-white/60">正在读取…</p>
              </div>
            </section>

            {/* 排行 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">文章阅读排行</h2>
                <div class="sp-section-extra text-black/70 dark:text-white/60">
                  累计 <b data-stat="total">—</b> 次
                </div>
              </div>
              <div id="stats-rank" class="sp-rank">
                {
                  posts.length === 0 ? (
                    <p class="sp-empty text-black/70 dark:text-white/60">没有可统计的文章。</p>
                  ) : (
                    posts.map((post, index) => (
                      <a
                        class="sp-rank-row"
                        href={post.url}
                        data-rank-id={post.id}
                        data-published={post.published}
                        data-rank={index + 1}
                      >
                        <span class="sp-rank-no">{index + 1}</span>
                        <span class="sp-rank-main">
                          <span class="sp-rank-title">{post.title}</span>
                          <span class="sp-rank-meta text-black/70 dark:text-white/60">
                            {post.published}
                            {post.category ? ` · ${post.category}` : ""}
                          </span>
                          <span class="sp-rank-track">
                            <i style="width:0%" />
                          </span>
                        </span>
                        <span class="sp-rank-num" data-rank-num>
                          …
                        </span>
                      </a>
                    ))
                  )
                }
              </div>
              <button
                id="stats-rank-toggle"
                class="btn-plain w-full mt-3"
                type="button"
                hidden
              >
                显示全部
              </button>
            </section>

            <p id="stats-status" class="sp-status text-black/70 dark:text-white/60" aria-live="polite">
              正在读取数据…
            </p>
            <p class="sp-note text-black/70 dark:text-white/60">
              统计由站内计数器在浏览器端完成，不使用 Cookie 追踪，只记录「页面被访问了几次」。
              加密文章不参与排行；同一页面 {statsConfig.dedupeMinutes} 分钟内的重复访问只计一次。
              更细致的来源、设备与行为分析见站长的 Microsoft Clarity 后台。
            </p>
          </>
        )
      }
    </div>
  </div>
</MainGridLayout>

<style is:global>
  /* 本页只复用主题既有变量与组件语言（--primary / --content-meta /
     --license-block-bg / --line-divider / card-base / btn-plain 等），
     不引入任何主题之外的颜色或组件风格。
     - 文字颜色交给主题工具类：text-black/90 dark:text-white/90（主）、
       text-black/70 dark:text-white/60（次），自动跟随主题明暗；
     - 强调色统一用 --primary，跟随主题色相（hue）与明暗；
     - 柱状图是 stats-page.js 运行时插入的 DOM，无法用模板类，故用全局
       样式引用主题变量上色。 */
  .sp-head {
    margin-bottom: 1.5rem;
  }

  .sp-title {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .sp-desc {
    margin: 0;
    font-size: 0.85rem;
  }

  /* 概览分组 */
  .sp-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sp-group {
    margin: 0;
  }

  .sp-group-title {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--content-meta);
    letter-spacing: 0.02em;
  }

  .sp-group-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
  }

  .sp-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
  }

  .sp-card-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sp-card-icon {
    line-height: 1;
    font-size: 1.15rem;
  }

  .sp-card-label {
    font-size: 0.75rem;
  }

  .sp-card-value {
    font-size: 1.6rem;
    line-height: 1.9rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .sp-card-sub {
    font-size: 0.68rem;
  }

  /* 区块 */
  .sp-section {
    margin-top: 2rem;
  }

  .sp-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-divider);
  }

  .sp-section-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .sp-section-extra {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  /* 累计 / 日均数字沿用主题强调色 */
  .sp-section-extra b {
    color: var(--primary);
  }

  /* 趋势图 */
  .sp-trend {
    overflow: visible;
  }

  .sp-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 11rem;
    margin-bottom: 1.6rem;
  }

  .sp-bar-wrap {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* 柱子一律用主题强调色 --primary（与主题 bg-(--primary) 徽章同色），
     不给「今天」换灰色，只用刻度文字（主题色 + 加粗）区分。 */
  .sp-bar {
    width: 100%;
    min-height: 2px;
    border-radius: 4px 4px 2px 2px;
    background: var(--primary);
    animation: sp-grow 0.5s ease both;
  }

  .sp-bar-wrap:hover .sp-bar {
    filter: brightness(1.1);
  }

  .sp-bar-label {
    position: absolute;
    bottom: -1.35rem;
    font-size: 0.65rem;
    color: var(--content-meta);
    white-space: nowrap;
  }

  .sp-bar-wrap.is-today .sp-bar-label {
    color: var(--primary);
    font-weight: 600;
  }

  .sp-chart-foot {
    margin: 0;
    font-size: 0.75rem;
    color: var(--content-meta);
    text-align: center;
  }

  /* 排行榜 */
  .sp-rank-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.6rem;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .sp-rank-row:hover {
    background: color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .sp-rank-no {
    flex: 0 0 auto;
    width: 1.6rem;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
  }

  .sp-rank-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .sp-rank-title {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sp-rank-meta {
    font-size: 0.7rem;
  }

  .sp-rank-track {
    display: block;
    height: 0.3rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    overflow: hidden;
  }

  .sp-rank-track i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--primary);
    transition: width 0.6s ease;
  }

  .sp-rank-num {
    flex: 0 0 auto;
    min-width: 3.5rem;
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
  }

  /* 状态与说明 */
  .sp-status {
    margin: 1.5rem 0 0;
    font-size: 0.75rem;
  }

  /* 报错色取主题已定义的告警色 */
  .sp-status[data-kind="error"] {
    color: var(--admonitions-color-caution);
  }

  .sp-note {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .sp-empty {
    margin: 0;
    padding: 1rem 0;
    font-size: 0.85rem;
  }

  @keyframes sp-grow {
    from {
      transform: scaleY(0.2);
      transform-origin: bottom;
    }
    to {
      transform: scaleY(1);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-bar,
    .sp-rank-track i {
      animation: none;
      transition: none;
    }
  }
</style>
