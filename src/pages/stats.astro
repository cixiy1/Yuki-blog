---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { statsConfig } from "@/config";
import { getStatsPostList } from "@/utils/stats-utils";

const pageCfg = statsConfig.page;
const enabled = statsConfig.enable && pageCfg.enable;

// 文章清单在构建期生成，直接渲染成 DOM（数字由 stats-page.js 从计数服务读取后填入）。
// ⚠️ 不要把这份清单塞进内联 <script>：Swup 站内跳转时容器是整块替换的，
//    内联脚本在 SPA 导航下不保证执行，而 DOM 一定是新的。
const posts = enabled ? await getStatsPostList() : [];
---

<MainGridLayout title={pageCfg.title} description={pageCfg.description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div
      id="stats-root"
      class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full text-black/90 dark:text-white/90"
      data-trend-days={pageCfg.trendDays}
      data-top-n={pageCfg.topN}
    >
      {
        !enabled ? (
          <p class="sp-empty text-black/70 dark:text-white/60">站内统计未启用。</p>
        ) : (
          <>
            <div class="sp-head">
              {/* 大屏由 banner 统一显示页面标题，这里只在窄屏补一个 */}
              <h1 class="sp-title lg:hidden">{pageCfg.title}</h1>
              <p class="sp-desc text-black/70 dark:text-white/60">{pageCfg.description}</p>
            </div>

            {/* 概览 */}
            <div class="sp-cards">
              <section class="sp-group">
                <h3 class="sp-group-title">总计</h3>
                <div class="sp-group-cards">
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">总浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pv">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">建站至今</div>
                  </div>
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">总访客数</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uv">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">浏览器永久去重</div>
                  </div>
                </div>
              </section>

              <section class="sp-group">
                <h3 class="sp-group-title">单日 · 今日</h3>
                <div class="sp-group-cards">
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pvToday">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">截至现在</div>
                  </div>
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数 · 去重</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uvToday">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">同一浏览器当日只算一次</div>
                  </div>
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:footprint" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数 · 未去重</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="hitsToday">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">每次打开都算一次</div>
                  </div>
                </div>
              </section>

              <section class="sp-group">
                <h3 class="sp-group-title">单周 · 本周</h3>
                <div class="sp-group-cards">
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:visibility" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">浏览量</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="pvWeek">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">周一至今</div>
                  </div>
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:group" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数 · 去重</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="uvWeek">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">每天各去重后相加</div>
                  </div>
                  <div class="sp-card">
                    <div class="sp-card-top">
                      <span class="sp-card-icon text-(--primary)"><Icon is:inline name="material-symbols:footprint" /></span>
                      <span class="sp-card-label text-neutral-500 dark:text-neutral-400">访客数 · 未去重</span>
                    </div>
                    <div class="sp-card-value text-neutral-900 dark:text-neutral-100" data-stat="hitsWeek">—</div>
                    <div class="sp-card-sub text-neutral-500 dark:text-neutral-400">每次打开都算一次</div>
                  </div>
                </div>
              </section>
            </div>

            {/* 趋势 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">近 {pageCfg.trendDays} 天浏览量</h2>
                <div class="sp-section-extra text-black/70 dark:text-white/60">
                  日均 <b data-stat="avg">—</b> 次
                </div>
              </div>
              <div id="stats-trend" class="sp-trend">
                <p class="sp-empty text-black/70 dark:text-white/60">正在读取…</p>
              </div>
            </section>

            {/* 排行 */}
            <section class="sp-section">
              <div class="sp-section-head">
                <h2 class="sp-section-title">文章阅读排行</h2>
                <div class="sp-section-extra text-black/70 dark:text-white/60">
                  累计 <b data-stat="total">—</b> 次
                </div>
              </div>
              <div id="stats-rank" class="sp-rank">
                {
                  posts.length === 0 ? (
                    <p class="sp-empty text-black/70 dark:text-white/60">没有可统计的文章。</p>
                  ) : (
                    posts.map((post, index) => (
                      <a
                        class="sp-rank-row"
                        href={post.url}
                        data-rank-id={post.id}
                        data-published={post.published}
                        data-rank={index + 1}
                      >
                        <span class="sp-rank-no">{index + 1}</span>
                        <span class="sp-rank-main">
                          <span class="sp-rank-title">{post.title}</span>
                          <span class="sp-rank-meta text-black/70 dark:text-white/60">
                            {post.published}
                            {post.category ? ` · ${post.category}` : ""}
                          </span>
                          <span class="sp-rank-track">
                            <i style="width:0%" />
                          </span>
                        </span>
                        <span class="sp-rank-num" data-rank-num>
                          …
                        </span>
                      </a>
                    ))
                  )
                }
              </div>
              <button
                id="stats-rank-toggle"
                class="btn-plain w-full mt-3"
                type="button"
                hidden
              >
                显示全部
              </button>
            </section>

            <p id="stats-status" class="sp-status text-black/70 dark:text-white/60" aria-live="polite">
              正在读取数据…
            </p>
            <p class="sp-note text-black/70 dark:text-white/60">
              <b>关于「去重」与「未去重」.</b>
              「浏览量」＝页面被打开的次数（同一页面 {statsConfig.dedupeMinutes} 分钟内重复打开只计一次）；
              「访客数 · 去重」＝按浏览器去重，其中<b>总计按「浏览器永久去重」</b>（同一浏览器一辈子只算一次），
              而<b>今日、本周按「每天去重」</b>（同一浏览器同一天只算一次，隔天再来又会算一次），
              本周的值＝周一至今各天的去重值<b>相加</b>。所以同一个人周一、周三各来一趟，
              在总访客里是 1，在本周里是 2 —— <b>单周的「去重访客」可以大于「总访客数」</b>，这是两处口径不同，不是数据出错。
              「访客数 · 未去重」＝访问人次，每次打开页面都记一次（含刷新），只用它与去重值对照。
            </p>
            <p class="sp-note text-black/70 dark:text-white/60">
              统计由站内计数器在浏览器端完成，不使用 Cookie 追踪。加密文章不参与排行。
              更细致的来源、设备与行为分析见站长的 Microsoft Clarity 后台。
            </p>
          </>
        )
      }
    </div>
  </div>
</MainGridLayout>

<style is:global>
  /* 本页只复用主题既有变量与组件语言（--primary / --content-meta /
     --license-block-bg / --line-divider / card-base / btn-plain 等），
     不引入任何主题之外的颜色或组件风格。
     - 文字颜色交给主题工具类：text-black/90 dark:text-white/90（主）、
       text-black/70 dark:text-white/60（次），自动跟随主题明暗；
     - 强调色统一用 --primary，跟随主题色相（hue）与明暗；
     - 柱状图是 stats-page.js 运行时插入的 DOM，无法用模板类，故用全局
       样式引用主题变量上色。 */
  .sp-head {
    margin-bottom: 1.5rem;
  }

  .sp-title {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .sp-desc {
    margin: 0;
    font-size: 0.85rem;
  }

  /* 概览分组 */
  .sp-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sp-group {
    margin: 0;
  }

  .sp-group-title {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--content-meta);
    letter-spacing: 0.02em;
  }

  .sp-group-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
  }

  .sp-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
  }

  .sp-card-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sp-card-icon {
    line-height: 1;
    font-size: 1.15rem;
  }

  .sp-card-label {
    font-size: 0.75rem;
  }

  .sp-card-value {
    font-size: 1.6rem;
    line-height: 1.9rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .sp-card-sub {
    font-size: 0.68rem;
  }

  /* 区块 */
  .sp-section {
    margin-top: 2rem;
  }

  .sp-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-divider);
  }

  .sp-section-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .sp-section-extra {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  /* 累计 / 日均数字沿用主题强调色 */
  .sp-section-extra b {
    color: var(--primary);
  }

  /* 趋势图 */
  .sp-trend {
    overflow: visible;
  }

  /* 柱区与底部轴共用同一套列定义：--sp-n 由脚本写入天数。
     两个容器各自 repeat 一遍，列宽和间距完全一致，逐列才能对齐。 */
  .sp-chart,
  .sp-axis {
    display: grid;
    grid-template-columns: repeat(var(--sp-n, 30), minmax(0, 1fr));
    gap: 0 3px;
  }

  .sp-chart {
    height: 11rem;
    /* 顶部留出柱顶数值的高度，柱高 100% 时数字仍能完整显示 */
    padding-top: 1.2rem;
    align-items: end;
  }


  .sp-bar-wrap {
    grid-row: 1;
    position: relative;
    height: 100%;
    min-width: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* 柱子一律用主题强调色 --primary（与主题 bg-(--primary) 徽章同色），
     不给「今天」换灰色，只用刻度文字（主题色 + 加粗）区分。 */
  .sp-bar {
    width: 100%;
    min-height: 2px;
    border-radius: 4px 4px 2px 2px;
    background: var(--primary);
    animation: sp-grow 0.5s ease both;
  }

  .sp-bar-wrap:hover .sp-bar {
    filter: brightness(1.1);
  }

  /* 柱顶数值：紧贴柱顶、向上生长。窄屏柱子只有十几像素宽，横向三位数会糊成一片，
     所以 ≤768px 改成竖排（text-orientation: upright 让每个数字正立）。 */
  .sp-bar-val {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -2px);
    font-size: 0.6rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--content-meta);
    white-space: nowrap;
    pointer-events: none;
  }

  .sp-bar-wrap.is-today .sp-bar-val {
    color: var(--primary);
    font-weight: 600;
  }

  /* 0 的那天数值调淡，避免和真实小数值混在一起 */
  .sp-bar-wrap.is-zero .sp-bar-val {
    opacity: 0.5;
  }

  /* 四位数（单日上千）在窄柱子里会贴边，收一号字 */
  .sp-bar-val.is-long {
    font-size: 0.5rem;
  }

  /* 底部轴：第一行每柱周几（与柱区逐列对齐），第二行每周起止日期 */
  .sp-axis {
    grid-template-rows: auto auto;
    margin-top: 1rem;
    row-gap: 0.32rem;
    font-size: 0.6rem;
    line-height: 1.25;
    color: var(--content-meta);
  }

  /* 周分隔：每周起始处一根细线，跨两行把「周几 + 日期」划成一组。
     不套框，日期字长一点也只是居中溢出，不会顶到边框上。 */
  .sp-week-sep {
    grid-row: 1 / span 2;
    justify-self: start;
    width: 1px;
    margin: -0.22rem 0 -0.2rem -2px;
    border-radius: 1px;
    background: var(--line-divider);
  }

  /* 线用主题色淡化，比纯灰线更贴柱子，也不至于抢过柱子本身 */
  @supports (color: color-mix(in oklab, red 50%, transparent)) {
    .sp-week-sep {
      background: color-mix(in oklab, var(--primary) 34%, transparent);
    }
  }

  .sp-axis-dow {
    grid-row: 1;
    justify-self: center;
    white-space: nowrap;
  }

  /* 周末的字淡一档，30 个单字排在一起时才有节奏 */
  .sp-axis-dow.is-weekend {
    opacity: 0.5;
  }

  .sp-axis-dow.is-today {
    color: var(--primary);
    font-weight: 600;
    opacity: 1;
  }

  /* 日期行比周几行低一档，别抢柱子和周几的视觉重心。
     居中于整周，没有框参照，稍微溢出一两个像素也看不出。 */
  .sp-axis-week {
    grid-row: 2;
    justify-self: center;
    font-size: 0.6rem;
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  /* 本周的日期用主题色标出来，代替原来给整周描框 */
  .sp-axis-week.is-current {
    color: var(--primary);
    font-weight: 600;
  }

  .sp-axis-range {
    opacity: 0.75;
    font-weight: inherit;
  }

  .sp-axis-week.is-current .sp-axis-range {
    opacity: 0.9;
  }

  .sp-chart-foot {
    margin: 1rem 0 0;
    font-size: 0.75rem;
    color: var(--content-meta);
    text-align: center;
  }

  @media (max-width: 768px) {
    /* 竖排的三位数标签要 25px 高，顶部留白得跟着放大，否则贴到标题上 */
    .sp-chart {
      padding-top: 2.6rem;
    }

    /* 窄屏柱子只剩 8px 上下，间距跟着收，两边必须同时改才能对齐 */
    .sp-chart,
    .sp-axis {
      gap: 0 2px;
    }

    .sp-bar-val {
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-size: 0.55rem;
      letter-spacing: -0.05em;
    }

    /* 周几单字收到 8px，正好一列宽，再大会压住隔壁 */
    .sp-axis {
      font-size: 0.5rem;
    }

    /* 一周只剩 60 多像素，起止区间放不下，只留起日 */
    .sp-axis-range {
      display: none;
    }

    /* 窄屏列缝只有 2px，分隔线贴到列沿 */
    .sp-week-sep {
      margin: -0.18rem 0 -0.16rem -1px;
    }

    .sp-axis-week {
      font-size: 0.52rem;
      letter-spacing: 0;
    }

    .sp-axis-dow {
      font-size: 0.46rem;
    }
  }

  /* 排行榜 */
  .sp-rank-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.6rem;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .sp-rank-row:hover {
    background: color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .sp-rank-no {
    flex: 0 0 auto;
    width: 1.6rem;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
  }

  .sp-rank-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .sp-rank-title {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sp-rank-meta {
    font-size: 0.7rem;
  }

  .sp-rank-track {
    display: block;
    height: 0.3rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    overflow: hidden;
  }

  .sp-rank-track i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--primary);
    transition: width 0.6s ease;
  }

  .sp-rank-num {
    flex: 0 0 auto;
    min-width: 3.5rem;
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
  }

  /* 状态与说明 */
  .sp-status {
    margin: 1.5rem 0 0;
    font-size: 0.75rem;
  }

  /* 报错色取主题已定义的告警色 */
  .sp-status[data-kind="error"] {
    color: var(--admonitions-color-caution);
  }

  .sp-note {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .sp-empty {
    margin: 0;
    padding: 1rem 0;
    font-size: 0.85rem;
  }

  @keyframes sp-grow {
    from {
      transform: scaleY(0.2);
      transform-origin: bottom;
    }
    to {
      transform: scaleY(1);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-bar,
    .sp-rank-track i {
      animation: none;
      transition: none;
    }
  }
</style>
